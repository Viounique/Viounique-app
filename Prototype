<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>DisasterApp – Phone Prototype</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="stylesheet" href="css/style.css">
</head><body>
<div class="cap">.NET MAUI app · 360 × 740 dp phone frame · tap everything — it all works</div>
<div class="phone">
 <div class="sb"><span>9:41</span><span>▲ ◉ ▮▮▮</span></div>
 <div class="hd"><label class="net on" id="net" data-a="net"><span id="nl">Online</span><span class="sw"></span></label>
  <h1>Disaster Assist</h1><p>Report an emergency · track rescue</p>
  <div class="seg"><button class="on" data-a="tv">Victim</button><button data-a="tc">Coordinator</button></div></div>
 <div class="pg" id="vv">
  <div class="qb hide" id="qb" role="status" aria-live="polite"></div>
  <div class="card"><div class="lbl">Who needs help</div><input id="nm" placeholder="Name"><input id="ph" placeholder="Phone" type="tel" style="margin:0"></div>
  <div class="card"><div class="lbl">Emergency type</div><div class="chips" id="types"></div></div>
  <div class="card"><div class="lbl">Number of people</div><div class="stp"><button data-a="minus">−</button><b id="n">1</b><button data-a="plus">+</button></div>
   <div class="lbl" style="margin-top:12px">Special care</div><div class="sub" style="margin-bottom:8px"></div><div id="care"></div></div>
  <div class="card gps" role="button" tabindex="0" data-a="gps"><div class="pin" id="pin">📍</div><div><b id="gt">Tap to capture GPS</b><div class="sub" id="gs">Required so rescuers can find you</div></div></div>
  <input id="lmk" class="hide" placeholder="Nearby landmark (e.g. school, temple)" style="margin:0">
  <button class="big" data-a="send">SEND REQUEST</button><div class="msg" id="ms" role="status" aria-live="polite"></div><div class="card hide" id="my"></div>
 </div>
 <div class="pg hide" id="cv">
  <div class="stats" id="stats"></div>
  <div class="card" style="padding:10px"><div class="lbl">People needing special care</div><div id="care-sum" style="display:flex;justify-content:space-around;text-align:center"></div></div>
  <div class="card" style="padding:10px"><div class="lbl">Filters</div><div class="frow"><select id="fty" aria-label="Type"></select><select id="fst" aria-label="Status"></select><select id="fca" aria-label="Care"></select></div><div class="sub" id="fcount" style="margin-top:8px"></div></div>
  <div class="card" style="padding:8px"><svg class="map" viewBox="0 0 100 56" id="map"></svg></div>
  <div id="ls" style="display:flex;flex-direction:column;gap:10px"></div>
 </div>
 <div class="nav"><i></i></div>
 <div id="sh" class="sheet hide" data-a="close"><div id="shb"></div></div>
 <div id="toast" class="toast hide"></div>
</div>
<script src="js/core.js"></script>
<script src="js/scoring.js"></script>
<script src="js/victim.js"></script>
<script src="js/sync.js"></script>
<script src="js/coordinator.js"></script>
<script src="js/cases.js"></script>
<script src="js/main.js"></script>
</body></html>
